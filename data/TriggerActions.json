{
	"Changes": [
	{
		"Action": "EditData",
		"Target": "Data/TriggerActions",
		"Entries": {
			// STAT TRACKING
			"{{ModId}}_CheckExperience": {
				"Id": "{{ModId}}_CheckExperience",
				"Trigger": "DayEnding",
				"Condition": "PLAYER_STAT Current {{ModId}}_Spellcasting 20",
				"MarkActionApplied": false,
				"Actions": [
					"AddMail Current {{ModId}}_isApprentice received",
					// give player +1 level - check parchment for adding pages
				]
			},
			"{{ModId}}_LevelUpNotification": {
				"Id": "{{ModId}}_LevelUpNotification",
				"Trigger": "DayStarted",
				"Condition": "PLAYER_HAS_MAIL Current {{ModId}}_isApprentice",
				"MarkActionApplied": false,
				"Actions": [
					"Spiderbuttons.BETAS_Message Strings/StringsFromCSFiles:{{ModId}}_LevelUpMessage",
				]
			},
			
			// MAIL AND FLAGS
			"{{ModId}}_WizardMail": {
				"Id": "{{ModId}}_WizardMail",
				"Condition": "!{{HasMod |contains=handwrittenhello.dbda}}, PLAYER_HEARTS Current Wizard 2",
				"Trigger": "DayStarted",
				"Actions": [
					"AddMail Current {{ModId}}_GiveSpellbook now"
				]
			},
			"{{ModId}}_UnsetLoveSpellFlag": {
				"Id": "{{ModId}}_UnsetLoveSpellFlag",
				"Condition": "PLAYER_HAS_MAIL Current {{ModId}}_UsedLoveSpellToday",
				"Trigger": "DayEnding",
				"MarkActionApplied": false,
				"Actions": [
					"RemoveMail Current {{ModId}}_UsedLoveSpellToday all",
					"Spiderbuttons.BETAS_SetFriendshipPoints {{TodaysNPC}} [PlayerModData {{ModId}}_CurrentFriendshipStoredValue]", // revert friendship to normal
					"AddConversationTopic {{ModId}}_LoveSpellWoreOff_{{TodaysNPC}}", // give specific NPC weirded out CT
					"RemoveConversationTopic {{ModId}}_UsedLoveSpell_{{TodaysNPC}}" // remove besotted love spell CT
				]
			},
		}
	},
	
